<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuickCopyTags.ViewModels"
        xmlns:models="using:QuickCopyTags.Models"
        x:Class="QuickCopyTags.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="QuickCopyTags Settings"
        Icon="avares://QuickCopyTags/Assets/icon.ico"
        Width="640"
        Height="440"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="220,*" Margin="12">
    <DockPanel Grid.Column="0" Margin="0,0,8,0">
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
        <Button Content="+ Add" Command="{Binding AddTagCommand}" />
        <Button Content="Delete" Command="{Binding DeleteTagCommand}" />
        <Button Content="↑" Command="{Binding MoveUpCommand}" />
        <Button Content="↓" Command="{Binding MoveDownCommand}" />
      </StackPanel>
      <ListBox x:Name="TagListBox"
                ItemsSource="{Binding Tags}"
                SelectedItem="{Binding SelectedTag}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="models:Tag">
            <Border Background="Transparent"
                    Padding="4"
                    PointerPressed="OnItemPointerPressed"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragEnter="OnItemDragEnter"
                    DragDrop.DragLeave="OnItemDragLeave"
                    DragDrop.DragOver="OnItemDragOver"
                    DragDrop.Drop="OnItemDrop">
              <TextBlock Text="{Binding Label}" />
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <StackPanel Grid.Column="1" Spacing="8" IsEnabled="{Binding SelectedTag, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="Label" FontWeight="Bold" />
      <TextBox x:Name="LabelBox" Text="{Binding SelectedTag.Label, Mode=TwoWay}" LostFocus="OnFieldLostFocus" />
      <TextBlock Text="Content" FontWeight="Bold" />
      <TextBox x:Name="ContentBox"
               Text="{Binding SelectedTag.Content, Mode=TwoWay}"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               Height="260"
               LostFocus="OnFieldLostFocus" />
    </StackPanel>
  </Grid>
</Window>
