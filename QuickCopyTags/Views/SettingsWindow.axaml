<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuickCopyTags.ViewModels"
        xmlns:models="using:QuickCopyTags.Models"
        x:Class="QuickCopyTags.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="QuickCopyTags Settings"
        Icon="avares://QuickCopyTags/Assets/icon.ico"
        Width="720"
        Height="520"
        MinWidth="600"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="*,Auto,Auto" Margin="12">
    <Grid Grid.Row="0" ColumnDefinitions="220,*">
      <ListBox x:Name="TagListBox"
                Grid.Column="0"
                Margin="0,0,8,0"
                ItemsSource="{Binding Tags}"
                SelectedItem="{Binding SelectedTag}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="models:Tag">
            <Border Background="Transparent"
                    Padding="4"
                    PointerPressed="OnItemPointerPressed"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragEnter="OnItemDragEnter"
                    DragDrop.DragLeave="OnItemDragLeave"
                    DragDrop.DragOver="OnItemDragOver"
                    DragDrop.Drop="OnItemDrop">
              <TextBlock Text="{Binding Label}" />
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" IsEnabled="{Binding SelectedTag, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Grid.Row="0" Text="Label" FontWeight="Bold" Margin="0,0,0,8" />
        <TextBox Grid.Row="1" x:Name="LabelBox" Text="{Binding SelectedTag.Label, Mode=TwoWay}" LostFocus="OnFieldLostFocus" Margin="0,0,0,8" />
        <TextBlock Grid.Row="2" Text="Category" FontWeight="Bold" Margin="0,0,0,8" />
        <ComboBox Grid.Row="3"
                  ItemsSource="{Binding CategoryOptions}"
                  DisplayMemberBinding="{Binding Name}"
                  SelectedValueBinding="{Binding Id}"
                  SelectedValue="{Binding SelectedTag.CategoryId, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  SelectionChanged="OnCategorySelectionChanged"
                  Margin="0,0,0,8" />
        <TextBlock Grid.Row="4" Text="Content" FontWeight="Bold" Margin="0,0,0,8" />
        <TextBox Grid.Row="5"
                 x:Name="ContentBox"
                 Text="{Binding SelectedTag.Content, Mode=TwoWay}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 LostFocus="OnFieldLostFocus" />
      </Grid>
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,12,0,0">
      <Button Content="+ Add" Command="{Binding AddTagCommand}" />
      <Button Content="Delete" Command="{Binding DeleteTagCommand}" />
      <Button Content="↑" Command="{Binding MoveUpCommand}" />
      <Button Content="↓" Command="{Binding MoveDownCommand}" />
      <TextBlock Text="Font size:" VerticalAlignment="Center" Margin="8,0,0,0" />
      <ComboBox ItemsSource="{Binding TagFontSizeOptions}"
                SelectedItem="{Binding TagFontSize, Mode=TwoWay}"
                Width="70"
                SelectionChanged="OnFontSizeSelectionChanged" />
      <Button Content="Categories" Margin="8,0,0,0" Click="OnManageCategoriesClick" />
      <Button Content="Tag-set file" Click="OnChangeTagFileLocationClick" />
    </StackPanel>

    <TextBlock Grid.Row="2" x:Name="TagFileLocationStatus" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" IsVisible="False" />
  </Grid>
</Window>
